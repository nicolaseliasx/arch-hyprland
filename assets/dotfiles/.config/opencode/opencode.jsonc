{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [],
  "model": "zai-coding-plan/glm-5.3",
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    },
    "code-index": {
      "type": "local",
      "command": [
        "/bin/sh",
        "-c",
        "root=$(git rev-parse --show-toplevel 2>/dev/null || true); if [ -n \"$root\" ]; then set -- --project-path \"$root\"; fi; exec \"$HOME/.local/bin/code-index-mcp\" \"$@\" --indexer-path \"$HOME/.cache/code-index-mcp\""
      ],
      "enabled": true,
      "timeout": 1200000
    }
  },
  "agent": {
    "plan": {
      "model": "zai-coding-plan/glm-5.3-highspeed",
      "reasoningEffort": "max"
    }
  },
  "skills": {
    "paths": [
      "$HOME/.opencode/skills"
    ]
  },
  "permission": "allow"
}
